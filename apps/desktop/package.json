{
  "name": "@pi-desktop/desktop",
  "version": "0.17.7",
  "desktopName": "deckwise.desktop",
  "private": true,
  "description": "DeckWise PPTX courseware desktop application",
  "homepage": "https://github.com/ganity/deckwise",
  "author": {
    "name": "vastsa",
    "email": "hhxk666@gmail.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter \"@pi-desktop/desktop^...\" --fail-if-no-match build",
    "predev": "pnpm run build:deps && cargo build --manifest-path ../../Cargo.toml -p host-core",
    "dev": "node ../../scripts/dev-electron.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:host-release": "cargo build --release --manifest-path ../../Cargo.toml -p host-core",
    "bundle:runtime": "pnpm -C ../../packages/agent-runtime bundle",
    "build:python-runtime": "node runtime/python/build-runtime.mjs --output dist/runtime/current",
    "prepare:ppt-master": "node ../../scripts/prepare-ppt-master.mjs --output dist/ppt-master",
    "stage:pptx-worker": "node ../../scripts/stage-pptx-worker.mjs",
    "check:pptx-worker": "node ../../scripts/stage-pptx-worker.mjs --check \"$PWD/resources/pptx-worker\"",
    "pack:courseware:linux": "pnpm run check:pptx-worker && pnpm --filter @pi-desktop/courseware-runtime test:authoring-bundle && pnpm run pack --linux --x64",
    "dist:courseware:linux": "pnpm run check:pptx-worker && pnpm --filter @pi-desktop/courseware-runtime test:authoring-bundle && pnpm run dist:linux --x64",
    "build:python-runtime:win": "node runtime/python/build-runtime.mjs --platform win --arch x64 --output dist/runtime/current",
    "runtime:mac:x64": "node runtime/python/build-runtime.mjs --platform mac --arch x64 --output dist/runtime/mac-x64",
    "runtime:mac:arm64": "node runtime/python/build-runtime.mjs --platform mac --arch arm64 --output dist/runtime/mac-arm64",
    "runtime:win:x64": "node runtime/python/build-runtime.mjs --platform win --arch x64 --output dist/runtime/win-x64",
    "runtime:linux:x64": "node runtime/python/build-runtime.mjs --platform linux --arch x64 --output dist/runtime/linux-x64",
    "runtime:linux:arm64": "node runtime/python/build-runtime.mjs --platform linux --arch arm64 --output dist/runtime/linux-arm64",
    "pack": "pnpm run prepare:ppt-master && pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run build:python-runtime && electron-vite build && electron-builder --dir",
    "dist": "pnpm run prepare:ppt-master && pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run build:python-runtime && electron-vite build && electron-builder --publish never",
    "dist:mac": "pnpm run prepare:ppt-master && pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run build:python-runtime && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "pnpm run prepare:ppt-master && pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run build:python-runtime:win && electron-vite build && electron-builder --win --publish never",
    "dist:linux": "pnpm run prepare:ppt-master && pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run build:python-runtime && electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@pi-desktop/agent-host": "workspace:*",
    "@pi-desktop/agent-runtime": "workspace:*",
    "@pi-desktop/courseware-runtime": "workspace:*",
    "@pi-desktop/i18n": "workspace:*",
    "@pi-desktop/plugin-devkit": "workspace:*",
    "@pi-desktop/plugin-sdk": "workspace:*",
    "@pi-desktop/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "dompurify": "^3.4.17",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "pinyin-pro": "3.29.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "ws": "8.21.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.trainwise.deckwise",
    "productName": "DeckWise",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://trainwise.oss-cn-beijing.aliyuncs.com/deckwise/"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{test,tests,__tests__,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{test,spec}.{js,cjs,mjs}",
      "!**/node_modules/node-addon-api/tools/**",
      "!**/node_modules/node-addon-api/*.{c,gyp,gypi,h,js,json}",
      "!**/node_modules/node-addon-api/README.md"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "tr",
      "de",
      "es",
      "fr",
      "ko"
    ],
    "extraResources": [
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../../packages/agent-runtime/dist-bundle",
        "to": "agent-runtime"
      },
      {
        "from": "dist/runtime/current",
        "to": "runtime"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "dist/ppt-master",
        "to": "skills/ppt-master"
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/editor-host",
        "to": "editor-host"
      },
      {
        "from": "resources/models.dev",
        "to": "models.dev"
      }
    ],
    "mac": {
      "artifactName": "DeckWise-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        },
        {
          "from": "build/tray-icon-mac.png",
          "to": "tray-icon-mac.png"
        }
      ],
      "extraDistFiles": [
        "DeckWise-macOS-open.command",
        "DeckWise-macOS-opening-help.txt"
      ]
    },
    "dmg": {
      "artifactName": "DeckWise-${version}-${arch}.${ext}",
      "background": "build/dmg-background.png",
      "window": {
        "width": 720,
        "height": 500
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 180,
          "y": 240
        },
        {
          "x": 540,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 470,
          "y": 370,
          "type": "file",
          "name": "If app won't open, read this.txt",
          "path": "DeckWise-macOS-opening-help.txt"
        }
      ]
    },
    "win": {
      "executableName": "DeckWise",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core.exe",
          "to": "bin/pi-desktop-host-core.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "app-icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeckWise",
      "artifactName": "DeckWise-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeckWise-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "deb": {
      "packageName": "deckwise",
      "artifactName": "deckwise_${version}_${arch}.${ext}"
    },
    "rpm": {
      "packageName": "deckwise",
      "artifactName": "deckwise-${version}-${arch}.${ext}",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "linux": {
      "executableName": "deckwise",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        },
        {
          "from": "resources",
          "to": ".",
          "filter": [
            "pptx-worker/**/*"
          ]
        },
        {
          "from": "../../packages/courseware-runtime/dist/authoring.mjs",
          "to": "pptx-worker/authoring.mjs"
        }
      ]
    },
    "asar": {
      "smartUnpack": false
    },
    "extraMetadata": {
      "piDistribution": "installed"
    }
  }
}
