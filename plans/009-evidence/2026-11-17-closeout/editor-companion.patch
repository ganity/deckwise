+  await adoptNativeTeachingAudio({ documentId: 'document', expectedRevision: readNativeTeaching()!.revision, pageId: 'page', actionId: 'reading', assetId: 'old', sha256, mimeType: 'audio/mpeg', durationMs: 1000, bytes });
